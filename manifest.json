{
  "manifest_version": 3,
  "name": "Watch Later Enhanced - Complete YouTube Watchlist",
  "version": "2.7.1",
  "description": "⚡ Alt+Click any YouTube video to save it instantly! Build and sort your custom Watch Later list with zero distractions.",
  "permissions": ["storage"],
  
  "browser_specific_settings": {
    "gecko": {
      "id": "watch-later-enhanced@adaddario.dev",
      "strict_min_version": "109.0"
    }
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self';"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/128px.png",
    "default_area": "menupanel"
  },
  
  "icons": {
    "48": "icons/48px.png",
    "128": "icons/128px.png"
  },
  
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": ["url-utils.js", "content.js", "detach.js"],
      "css": ["content.css"]
    }
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "sounds/*", "detach.css"],
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ]
    }
  ]
}